{
  "expo": {
    "name": "LustreMobile",
    "slug": "LustreMobile",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lustremobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Микрофон нужен для голосовых звонков"
      }
    },
    "android": {
      "package": "com.lustrehub.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F0F15",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "USE_FULL_SCREEN_INTENT",
        "WAKE_LOCK",
        "REQUEST_INSTALL_PACKAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@livekit/react-native-expo-plugin",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0F15",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна для сканирования QR-кода при подтверждении входа"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1af20083-bb3e-4d3c-b1b0-683e88b1d845"
      }
    },
    "owner": "lustrehub"
  }
}
